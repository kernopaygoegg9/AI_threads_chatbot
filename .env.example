# 複製成 .env 後填入（.env 不會被 commit）。GitHub Actions 上請改設成 Secrets / Variables，見 README。

# --- 安全開關 ---
DRY_RUN=true                       # true：不會真的發到 Threads

# --- Threads（Meta 開發者後台取得）---
THREADS_USER_ID=
THREADS_USERNAME=
THREADS_ACCESS_TOKEN=              # 60 天長效 token
THREADS_APP_SECRET=                # 只有 exchange-token 指令會用到

# --- Claude ---
ANTHROPIC_API_KEY=

# --- 圖片（依 config/settings.yaml 的 image.provider 擇一）---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Discord 審核 ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_REVIEWER_IDS=              # 逗號分隔的 Discord 使用者 ID；留空表示任何人都能核准

# --- 本機控制台用：建立公開圖片網址 ---
GITHUB_REPOSITORY=kernopaygoegg9/AI_threads_chatbot
